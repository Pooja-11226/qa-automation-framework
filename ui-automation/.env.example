# Copy this file to .env (git-ignored) and adjust as needed:  cp .env.example .env
# The SauceDemo credentials below are public demo accounts published on the login page.
# For a real system, inject these from a secret store / CI secrets instead.

BASE_URL=https://www.saucedemo.com
STANDARD_USER=standard_user
LOCKED_OUT_USER=locked_out_user
USER_PASSWORD=secret_sauce

# Optional tuning
# LOG_LEVEL=info              # debug | info | warn | error
# TEST_TIMEOUT_MS=30000
# EXPECT_TIMEOUT_MS=5000
# ACTION_TIMEOUT_MS=10000
# NAVIGATION_TIMEOUT_MS=15000
# FAKER_SEED=12345            # makes generated customer data reproducible
# BROWSERS=chromium           # comma-separated: chromium,firefox,webkit
